# Official Cloudflare Turnstile testing keys. These are intentionally public
# and must never be used in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

PUBLIC_BASE_URL=http://localhost:8788
RESUME_KV_KEY=replace-with-a-private-random-key
GMAIL_FROM_EMAIL=csarun.careers@gmail.com
ADMIN_EMAIL=csarun.careers@gmail.com

# Enter real secrets only in your untracked .dev.vars file when intentionally
# performing an end-to-end local test. Normal automated tests use mocks.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
RATE_LIMIT_SALT=

